# Defaults to a persistent embedded PostgreSQL database in .data/scopelens
# DATABASE_URL=postgresql://scopelens:change-me@localhost:5432/scopelens
PORT=4000
HOST=127.0.0.1
# Required when NODE_ENV=production or HOST is not loopback. At least 32 characters.
# API_TOKEN=generate-a-long-random-token
# Optional hosted AI (OpenAI-compatible chat completions endpoint)
# AI_API_KEY=
# AI_MODEL=
# AI_BASE_URL=https://api.openai.com/v1

# Optional isolated data path for local tests
# SCOPELENS_DATA_DIR=.data/scopelens
